FROM registry.access.redhat.com/ubi9/python-312-minimal
# Files injected into an OpenShift build arrive readable by root only.
COPY --chmod=644 app.py index.html ./
RUN python -c "import urllib.request; urllib.request.urlretrieve('https://cdn.jsdelivr.net/npm/@patternfly/patternfly@5/patternfly.min.css', 'patternfly.min.css')"
CMD ["python", "app.py"]
